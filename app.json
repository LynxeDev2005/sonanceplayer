{
  "expo": {
    "name": "player-sonance",
    "slug": "player-sonance",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sonance",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jttacalig.playersonance",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "UIBackgroundModes": [
          "audio"
        ],
        "NSAppleMusicUsageDescription": "Sonance needs access to your media library to play and manage your imported music tracks.",
        "NSDocumentsFolderUsageDescription": "Sonance needs access to your documents to import audio files and playlists.",
        "NSPhotoLibraryUsageDescription": "Sonance needs access to your photo library to set custom album artwork."
      }
    },
    "platforms": [
      "ios"
    ],
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8fb0a7b2-3919-4530-a59b-2d719992e4be"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8fb0a7b2-3919-4530-a59b-2d719992e4be"
    }
  }
}
